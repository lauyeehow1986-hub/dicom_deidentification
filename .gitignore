# --- Claude / worktree tangle (this folder was previously bound to the home .git) ---
.claude/

# --- R ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
/renv/library/
/renv/staging/

# --- Python engine (relocatable uv venv is built locally / moved onto the air-gapped box) ---
inst/python/.venv/
inst/python/venv/
__pycache__/
*.pyc
.python-version

# --- NER / OCR model weights (moved onto the air-gapped box separately; too big for git) ---
inst/models/
*.safetensors
*.onnx
*.bin

# --- PHI SAFETY: never commit real or working medical data ---
# Only synthetic, programmatically-generated fixtures under inst/testdata/synthetic/ are allowed.
/data/
/input/
/output/
*.dcm
*.dicom
*.nii
*.nii.gz
!inst/testdata/synthetic/**

# --- app runtime state (keystore, manifests, audit logs live outside git) ---
/run/
# self-improvement workspace: per-project profiles, grown gazetteers, labeled
# examples. May contain identifiers captured from real studies -> never commit.
/workspace/
*.sqlite
*.sqlite3
keystore/
keystores/
crosswalk/
audit/
# Ed25519 signing keys + any stray global keystore at the repo root: SECRETS
# (re-link patients / sign as the pipeline) -> never commit.
signing/
*.key
*.pem
/global.json

# --- Phase 7 build output (staged portable bundle) ---
/dist/
# Build-input binaries fetched on the connected machine (portable Tesseract, etc.);
# too big for git and rebuilt by tools/build_portable_bundle.ps1.
/vendor/
/bin/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
